[Unit]
Description=New Alliance Gallery - native animated renderer
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/pi/gallery
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=SDL_VIDEODRIVER=wayland
# Same lesson as the Chromium kiosk: starting before the compositor has settled
# the output geometry leaves the window the wrong size for good. Wait for the
# socket, then let SDL size itself to whatever the display ended up as.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && exit 0; sleep 1; done; exit 1'
ExecStart=/home/pi/gallery/native/gallery --coords /home/pi/gallery/coords.json
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=default.target
